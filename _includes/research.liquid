<div class="research">
  {% for theme in site.data.research %}
    <div class="research-theme">
      <h3 class="research-theme-title">{{ theme.theme }}</h3>
      {% if theme.intro %}
        <p class="research-theme-intro">{{ theme.intro }}</p>
      {% endif %}

      {% for project in theme.projects %}
        <div class="row research-project{% unless project.image %} research-project-text-only{% endunless %}">
          {% if project.image %}
            <div class="col-sm-5 research-media{% if project.diagram %} research-diagram{% endif %}">
              {% assign image_path = project.image | prepend: 'assets/img/' %}
              {% if project.image contains '.gif' %}
                {% include figure.liquid path=image_path class="img-fluid rounded" alt=project.alt avoid_scaling=true %}
              {% else %}
                {%
                  include figure.liquid path=image_path class="img-fluid rounded" alt=project.alt sizes="(min-width: 576px) 360px, 95vw"
                  zoomable=true
                %}
              {% endif %}
            </div>
          {% endif %}
          <div class="{% if project.image %}col-sm-7{% else %}col-12{% endif %} research-text">
            <h4 class="research-title">{{ project.title }}</h4>
            <div class="research-meta">
              <span class="research-venue">{{ project.venue }}</span>
              {% for link in project.links %}
                <a class="research-link" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.name }}</a>
              {% endfor %}
            </div>
            <p>{{ project.text }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endfor %}
</div>
